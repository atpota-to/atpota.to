# atpotato-weather. Lives on the droplet as /root/atpotato-weather/.env (mode 600),
# read by systemd (EnvironmentFile) and by `npm start`. See droplet/README.md.

# Shared with Vercel as ATMOSPHERE_STATION_SECRET. At least 32 characters:
#   openssl rand -hex 32
WEATHER_SECRET=

PORT=8790

# Supabase project "atpota.to" (zdzjtziydmwkxbzlkwxv). Service role: writes only,
# never leaves the droplet. Without both, the minute writer is off and /v1/now
# still works.
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only for backfilling from Jetstream's archive (src/archive.js); the station never
# uses it. Free, from https://bsky.network/account.
# JETSTREAM_API_KEY=
# JETSTREAM_SDK_DIR=/root/atpotato-weather/jetstream-sdk

# JETSTREAM_URLS=wss://jetstream2.us-east.bsky.network/subscribe,wss://jetstream1.us-east.bsky.network/subscribe
# MAX_REPLAY_SECONDS=1800
# STATE_FILE=state.json
# LOG_LEVEL=info
