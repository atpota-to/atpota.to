# atpotato-garden. Lives on the droplet as /root/atpotato-garden/.env (mode 600),
# read by systemd (EnvironmentFile) and by `npm start` / `npm run backfill`. No quotes
# around values. See README.md and droplet/README.md.

# Supabase project "atpota.to" (zdzjtziydmwkxbzlkwxv). Service role: the same two values
# as /root/atpotato-weather/.env. Never leaves the droplet. Both are required.
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Everything below is optional; the defaults are shown.

# Jetstream v2 hosts, comma-separated, tried in order. One connection at a time.
# JETSTREAM_HOSTS=wss://jetstream2.us-east.bsky.network,wss://jetstream1.us-east.bsky.network

# Where a reconcile finds the repos with garden records (listReposByCollection),
# and where it resolves did:plc documents to find each repo's PDS.
# RELAY_URL=https://relay1.us-east.bsky.network
# PLC_URL=https://plc.directory

# /healthz, on localhost only.
# HOST=127.0.0.1
# PORT=8791

# Jetstream cursors and when the last reconcile finished, relative to the data folder.
# STATE_FILE=state.json

# A full reconcile against every repo this often (hours).
# RECONCILE_HOURS=6
# Reconnect to Jetstream this often (minutes), from the saved cursor: the stream is
# quiet for hours, so this is what notices a socket that died without closing.
# RECYCLE_MINUTES=15
# Look for flowers to settle this often (seconds).
# SETTLE_SECONDS=30

# debug, info, warn or error.
# LOG_LEVEL=info
