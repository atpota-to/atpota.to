{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && sh scripts/og-browser.sh",
  "buildCommand": "npm run publish:lexicons -- --vercel && npm run build && PLAYWRIGHT_BROWSERS_PATH=0 npm run og -- --out dist/og --soft",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist",
  "functions": {
    "api/og-weather.ts": {
      "maxDuration": 30,
      "supportsCancellation": true,
      "includeFiles": "{server/og-fonts/**,src/assets/wordmark.svg,src/assets/mascot/*.svg,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    },
    "api/*.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "rewrites": [
    { "source": "/.well-known/site.standard.publication/blog", "destination": "/api/blog?view=well-known" },
    { "source": "/blog", "destination": "/api/blog?view=index" },
    { "source": "/blog/feed.xml", "destination": "/api/blog?view=feed" },
    { "source": "/blog/:path*", "destination": "/api/blog?view=post&path=:path*" },
    { "source": "/receive_auth_callback", "destination": "/api/blog?view=email-return" },
    { "source": "/og/weather.png", "destination": "/api/og-weather" },
    { "source": "/garden/:actor", "destination": "/garden" },
    { "source": "/garden/:actor/flowers", "destination": "/garden" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://roomy.chat/-/atproto.garden",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "atproto.garden"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://roomy.chat/-/atproto.garden",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.atproto.garden"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/.well-known/site.standard.publication/guides",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/oauth-client-metadata.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "atproto.garden"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
