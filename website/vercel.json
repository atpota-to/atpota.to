{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://roomy.chat/-/atproto.garden",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "atproto.garden"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://roomy.chat/-/atproto.garden",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.atproto.garden"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "atproto.garden"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
