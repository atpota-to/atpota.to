# atpotato-mentions — copy to .env and fill in. Never commit .env.
# The unit file reads this with EnvironmentFile=, so no quotes around values.

# --- milestone dial --------------------------------------------------------
# 1  detect only          match and queue, nothing is sent or posted
# 2  + inbound gates      gate verdicts recorded, nothing is sent or posted
# 3  + agent drafts       drafts land in the queue, nothing is posted
# 4  + post               replies are posted
# Move up one at a time. Stage 3 is the last point where mistakes are free.
STAGE=1

# --- identity --------------------------------------------------------------
# THE ACCOUNT BEING WATCHED. Resolved once and hard-coded, never resolved at
# runtime. The variable names say ATPOTATO for historical reasons; the service
# watches whatever DID is set here.
#
# Use ./scripts/switch-account.sh <handle> <app-password> to change accounts --
# it resolves the DID, rewrites all three values together, archives the old
# database and verifies the credential actually belongs to the new DID. Changing
# the DID without the matching app password makes createSession refuse to start,
# which is deliberate.
#
# Which account is watched also decides the right substanceMinChars in
# gates.json: a brand account wants null, a dedicated bot account wants a
# number. See the note in src/config.js.
ATPOTATO_DID=did:plc:qntsxa2i4sb24noi45fx4np2
ATPOTATO_HANDLE=atpota.to
PDS_URL=https://pds.atpota.to

# The posting credential. This service is the only thing that ever holds it.
# Required at stage 4. Also needed below stage 4 for the notification sweep,
# which is the only cover for a Jetstream gap — leave it blank and the sweep
# disables itself with a warning.
ATPROTO_APP_PASSWORD=

# --- the agent -------------------------------------------------------------
# Required from stage 3.
AGENT_URL=
# Must match DROPLET_SHARED_SECRET in the agent's Vercel environment. One secret
# currently covers both directions.
DROPLET_SHARED_SECRET=
# Where the agent POSTs drafts. Must be reachable from Vercel — the local
# listener below is bound to 127.0.0.1, so put a TLS terminator in front of it
# and point this at the public name.
DROPLET_CALLBACK_URL=
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8787

# --- jetstream -------------------------------------------------------------
# Comma-separated; each host is consumed independently and duplicates are free.
# Default is us-west first: on 2026-09-18 jetstream.us-east.bsky.network
# answered 503 from this droplet while us-west served both endpoint shapes.
JETSTREAM_URL=wss://jetstream.us-west.bsky.network,wss://jetstream.us-east.bsky.network

# --- kill switch -----------------------------------------------------------
# Stops the poster while the consumer keeps running. Independent of STAGE:
# checked at post time on every call, never cached, so it works at any stage
# without a restart. It DROPS rather than pauses -- a draft it catches is
# recorded `rejected` and is not posted later when the switch is cleared.
#   touch /root/atpotato-mentions/KILL      immediate, no restart
#   KILL_SWITCH=1                           survives a restart
# To also stop the agent turns (and the bill), set "globalPerHour": 0 in
# gates.json -- that is an inbound gate, so nothing reaches the agent at all.
KILL_SWITCH=
KILL_SWITCH_FILE=KILL

# Overrides globalPerHour in gates.json (needs a restart; the JSON file does not).
# GLOBAL_RATE_PER_HOUR=10

# --- weekly dispatch -------------------------------------------------------
# Off: the announce command is not recognised and DMs are routed as before.
DISPATCH_ENABLED=false
# Off (the default) is shadow mode for the later review flow. The announce
# command does not need it: the operator's command is the approval.
DISPATCH_PUBLISH_ENABLED=false
# Where the announcement card links: https://poe.leaflet.pub or https://atpota.to/blog
# DISPATCH_ANNOUNCE_URL_BASE=https://atpota.to/blog
# DISPATCH_PUBLICATION_URI=at://did:plc:qntsxa2i4sb24noi45fx4np2/site.standard.publication/3myar4h4pls2n
# An app password for atpota.to, used only for site.standard.document writes in
# that publication. Without it, announce posts and DMs the manual link command.
# DISPATCH_PUBLISHER_IDENTIFIER=atpota.to
# DISPATCH_PUBLISHER_APP_PASSWORD=

# --- weather posts ---------------------------------------------------------
# Poe posting the Atmosphere's weather on its own account (src/weather-posts.js):
#   post   gated drafts are posted (the default; stage 4 only)
#   draft  the watcher asks Poe and gates its drafts, and holds every one. Read
#          them with `npm run weather`
#   off    nothing runs
# Needs the agent's /weather/moment route deployed. Drafts come back on
# DROPLET_CALLBACK_URL like replies, so nginx needs nothing new. How often, which
# kinds and the caps are in gates.json (the weather* keys, defaults in src/config.js).
# The kill switch and a nap stop it too.
# WEATHER_POSTS=post
# WEATHER_POLL_MS=300000
# WEATHER_API_BASE=https://atpota.to/api
# WEATHER_DRAFT_TIMEOUT_MS=900000

# Poe's avatar and banner changing with the sky over New York (src/profile-look.js):
# dawn, day, golden hour and night, from the library at atpota.to/poe-profile.
#   on       the avatar and banner are changed (the default; stage 4 only). Only
#            those two fields: the name, bio and pinned post are left as they are
#   dry-run  each change is worked out and logged, nothing is written. Read them
#            with `npm run profile-look`
#   off      nothing runs
# The kill switch stops it. A nap gives Poe the sleepy face. Changing the avatar
# or banner by hand leaves the profile alone until the next day.
# PROFILE_LOOK=on
# PROFILE_LOOK_BASE=https://atpota.to/poe-profile
# PROFILE_LOOK_POLL_MS=300000

# --- misc ------------------------------------------------------------------
DB_FILE=mentions.db
GATES_FILE=gates.json
LOG_LEVEL=info
# NOTIFY_POLL_MS=180000
# RECONCILE_MS=120000
# STATS_EVERY_MS=300000
